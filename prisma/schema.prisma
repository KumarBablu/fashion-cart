// Fashion Cart — Prisma Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PAYMENT_PENDING
  SCREENSHOT_SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum PaymentMethod {
  MANUAL_UPI
  ONLINE_GATEWAY
  COD
}

enum InventoryTxnType {
  STOCK_IN
  SALE
  ADJUSTMENT
  RETURN
  CANCELLED_ORDER
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses        Address[]
  cart             Cart?
  wishlist         Wishlist?
  orders           Order[]
  sessions         Session[]
  reviews          Review[]
  verifiedPayments Payment[] @relation("VerifiedBy")

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  parentId  String?
  parent    Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToSubcategory")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products Product[]

  @@index([parentId])
  @@index([isActive, parentId, sortOrder])
  @@index([slug, isActive])
}

// ============================================================
// SELLER / VENDOR (Admin Order Fulfillment & Supplier Links)
// ============================================================

model Seller {
  id        String   @id @default(cuid())
  sellerId  String   @unique // e.g. "SLR-1001", "SLR-MEESHO-42"
  name      String
  phone     String?
  email     String?
  url       String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([sellerId])
  @@index([name])
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id             String        @id @default(cuid())
  productId      String?       // Custom / SKU master ID if provided in CSV
  name           String
  slug           String        @unique
  description    String?
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  
  // Categorization & Hierarchy
  department     String?       // e.g. Women, Men, Kids, Boys, Girls, Unisex
  subcategory    String?       // e.g. Sarees, Dresses, Shirts, Kurtas, Jeans, Footwear
  categoryPath   String?       // e.g. "Women > Ethnic Wear > Sarees"
  productType    String?       // e.g. "Banarasi Silk Saree", "Casual Oxford Shirt"
  productUrl     String?       // External source / product link

  // Specifications & Attributes
  brand          String?
  fabric         String?
  material       String?
  pattern        String?       // e.g. Zari Woven, Solid, Printed, Striped
  fit            String?       // e.g. Regular, Slim, Relaxed, Tailored
  occasion       String?       // e.g. Wedding, Festive, Casual, Party, Formal
  currency       String?       @default("INR")
  availability   String?       @default("IN_STOCK") // IN_STOCK, OUT_OF_STOCK, PRE_ORDER

  // Admin Supplier / Seller Relationship (Confidential)
  sellerId       String?
  seller         Seller?       @relation(fields: [sellerId], references: [id])
  sellerName     String?
  sellerIdentifier String?     // e.g. SellerID from CSV
  sellerUrl      String?
  sellerPhone    String?
  sellerEmail    String?

  status         ProductStatus @default(ACTIVE)
  isFeatured     Boolean       @default(false)
  isNewArrival   Boolean       @default(false)
  isBestSeller   Boolean       @default(false)
  averageRating  Decimal       @default(4.8) @db.Decimal(3, 2)
  totalReviews   Int           @default(0)
  ratingCount    Int           @default(0)
  reviewCount    Int           @default(0)
  tags           String?
  specifications Json?
  sizeChart      Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants      ProductVariant[]
  images        ProductImage[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([status, isNewArrival])
  @@index([status, isBestSeller])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String   @unique
  colour         String
  size           String
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  stockQuantity  Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images        ProductImage[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  inventoryTxns InventoryTransaction[]

  @@index([productId])
  @@index([productId, isActive])
  @@index([isActive, price])
  @@unique([productId, colour, size])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  imageUrl  String
  altText   String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([productId, sortOrder])
}

// ============================================================
// CART
// ============================================================

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id     String         @id @default(cuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]
}

model WishlistItem {
  id         String          @id @default(cuid())
  wishlistId String
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  createdAt  DateTime        @default(now())

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
}

// ============================================================
// ADDRESS
// ============================================================

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  mobileNumber String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pinCode      String
  landmark     String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

// ============================================================
// COUPON / PROMO CODES
// ============================================================

model Coupon {
  id                String    @id @default(cuid())
  code              String    @unique
  description       String?
  discountType      String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  discountValue     Decimal   @db.Decimal(10, 2)
  minOrderAmount    Decimal?  @db.Decimal(10, 2)
  maxDiscountAmount Decimal?  @db.Decimal(10, 2)
  startDate         DateTime  @default(now())
  endDate           DateTime?
  usageLimit        Int?
  usedCount         Int       @default(0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders Order[]
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating          Int      @default(5)
  title           String?
  comment         String
  fitRating       String?  // RUNS_SMALL, TRUE_TO_SIZE, RUNS_LARGE
  qualityRating   Int?     // 1 to 5
  colorAccuracy   String?  // EXACT_MATCH, SLIGHT_VARIATION, VERY_DIFFERENT
  comfortRating   Int?     // 1 to 5
  valueRating     Int?     // 1 to 5
  sizePurchased   String?  // XS, S, M, L, XL, XXL, FREE_SIZE
  occasionWorn    String?  // WEDDING_FESTIVE, PARTY_EVENING, WORK_OFFICE, CASUAL_DAILY
  recommend       Boolean? @default(true)
  isVerifiedBuyer Boolean  @default(true)
  status          String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([productId, status, createdAt(sort: Desc)])
}

// ============================================================
// BANNERS & PROMOS
// ============================================================

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  badge      String?
  linkUrl    String?
  imageUrl   String?
  buttonText String?  @default("Shop Now")
  position   String   @default("HERO") // HERO, PROMO_BAR, MIDDLE_BANNER
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, position, sortOrder])
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id                     String      @id @default(cuid())
  orderNumber            String      @unique
  userId                 String
  user                   User        @relation(fields: [userId], references: [id])
  status                 OrderStatus @default(PENDING_PAYMENT)
  paymentMethod          String      @default("MANUAL_UPI")
  subtotal               Decimal     @db.Decimal(10, 2)
  discount               Decimal     @default(0) @db.Decimal(10, 2)
  deliveryCharge         Decimal     @default(0) @db.Decimal(10, 2)
  tax                    Decimal     @default(0) @db.Decimal(10, 2)
  total                  Decimal     @db.Decimal(10, 2)
  couponId               String?
  coupon                 Coupon?     @relation(fields: [couponId], references: [id])
  couponCode             String?
  couponDiscount         Decimal     @default(0) @db.Decimal(10, 2)
  addressId              String?
  address                Address?    @relation(fields: [addressId], references: [id])
  shippingAddressSnapshot Json
  trackingNumber         String?
  carrierName            String?
  customerNotes          String?
  adminNotes             String?
  cancelledAt            DateTime?
  cancelRequestedAt      DateTime?
  cancelReason           String?
  cancellationStatus     String?     // REQUESTED, APPROVED, REJECTED, COMPLETED
  cancellationNotes      String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  items         OrderItem[]
  payment       Payment?
  invoice       Invoice?
  inventoryTxns InventoryTransaction[]

  @@index([userId])
  @@index([status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  skuSnapshot         String
  sizeSnapshot        String
  colourSnapshot      String
  quantity            Int
  unitPrice           Decimal         @db.Decimal(10, 2)
  total               Decimal         @db.Decimal(10, 2)

  @@index([orderId])
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod @default(MANUAL_UPI)
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PAYMENT_PENDING)
  utrNumber         String?       @unique
  gatewayName       String?       // e.g. "Instant Online Gateway", "Manual UPI", "Cash on Delivery"
  paymentChannel    String?       // e.g. "UPI", "CARD", "NETBANKING", "WALLET", "PAYLATER"
  instrumentDetails String?       // e.g. "Google Pay (user@okaxis)", "Visa Debit •••• 4111", "Bank of Baroda Netbanking"
  paymentMetadata   Json?         // Full gateway raw payment JSON object
  refundId          String?       // Gateway refund ID (e.g. rfnd_xxx)
  refundStatus      String?       // INITIATED, PROCESSED, FAILED
  refundAmount      Decimal?      @db.Decimal(10, 2)
  refundArn         String?       // Bank Acquirer Reference Number / RRN
  refundSpeed       String?       // normal, instant, optimum
  refundNotes       String?
  refundCreatedAt   DateTime?
  refundCompletedAt DateTime?
  screenshotPath    String?
  submittedAt       DateTime?
  verifiedAt        DateTime?
  verifiedById      String?
  verifiedBy        User?         @relation("VerifiedBy", fields: [verifiedById], references: [id])
  rejectionReason   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
}

model PaymentSettings {
  id           String   @id @default(cuid())
  qrCodePath   String?
  upiId        String?
  payeeName    String?  @default("Bablu Kumar")
  instructions String?
  codEnabled   Boolean  @default(true)
  codFee       Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model DeliverySettings {
  id                String   @id @default(cuid())
  defaultCharge     Decimal  @default(0) @db.Decimal(10, 2)
  freeDeliveryAbove Decimal? @db.Decimal(10, 2)
  updatedAt         DateTime @updatedAt
}

model BusinessSettings {
  id              String   @id @default(cuid())
  businessName    String?
  businessAddress String?
  gstin           String?
  phone           String?
  email           String?
  updatedAt       DateTime @updatedAt
}

model EmailSettings {
  id               String   @id @default(cuid())
  smtpHost         String?
  smtpPort         Int?     @default(587)
  smtpUser         String?
  smtpPassword     String?
  smtpSecure       Boolean  @default(false)
  fromEmail        String   @default("notifications@fashioncart.shop")
  fromName         String   @default("Fashion Cart")
  notifyAdminEmail String?
  updatedAt        DateTime @updatedAt
}

model EmailLog {
  id        String   @id @default(cuid())
  recipient String
  subject   String
  template  String
  status    String   @default("SENT")
  error     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([recipient])
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  pdfPath       String?
  createdAt     DateTime @default(now())
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryTransaction {
  id        String           @id @default(cuid())
  variantId String
  variant   ProductVariant   @relation(fields: [variantId], references: [id])
  type      InventoryTxnType
  quantity  Int
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id])
  notes     String?
  createdAt DateTime         @default(now())

  @@index([variantId])
}

// ============================================================
// COUNTERS (for order/invoice numbering)
// ============================================================

model Counter {
  id    String @id
  value Int    @default(0)
}

// ============================================================
// PROMOTIONS & FESTIVE OFFERS ENGINE
// ============================================================

enum PromotionPlacement {
  TOP_BANNER
  POPUP_MODAL
  HERO_SPOTLIGHT
  FLOAT_SNACKBAR
}

enum PromotionTheme {
  FESTIVE_GOLD
  ROYAL_RUBY
  EMERALD_EID
  SUNSET_ORANGE
  MODERN_DARK
}

model Promotion {
  id           String             @id @default(cuid())
  title        String
  subtitle     String?
  badgeText    String?
  imageUrl     String?
  ctaText      String?            @default("Shop Now")
  ctaUrl       String?            @default("/shop")
  discountCode String?
  placement    PromotionPlacement @default(TOP_BANNER)
  theme        PromotionTheme     @default(FESTIVE_GOLD)
  isActive     Boolean            @default(true)
  showOnLogin  Boolean            @default(false)
  showOnGuest  Boolean            @default(true)
  delayMinutes Int                @default(0)
  sortOrder    Int                @default(0)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([placement, isActive])
  @@index([isActive, placement, sortOrder])
}
